        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    // Add your code here
    if (!current.u_submission_state.changesTo('Submitted')) {
        return;
    }
    var user = gs.getUser();
    var userId = gs.getUserID();

    current.u_submitter = userId;

    if (user.isMemberOf('AMP OMI Representatives')) {
        current.u_submission_type = 'OMI Representative';
    } else if (user.isMemberOf('AMP FMC Representatives')) {
        current.u_submission_type = 'FMC Representative';
    } else {
        current.u_submission_type = 'Site Representative';
    }

})(current, previous);]]></script>
